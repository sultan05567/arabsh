rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'dd0229662@gmail.com' ||
        request.auth.token.email == '1007363904@arabstore.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager'))
      );
    }

    // Settings: Public read, authenticated users / admins write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Categories: Public can view categories, authorized can manage
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Products: Public can view products, authorized can manage
    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Reviews: Public can view reviews, registered users can post, authors or admins can manage
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Users: users can read and manage their profile, admins can manage all
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // User permissions: logged-in users can read, authenticated admins/managers can update
    match /user_permissions/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Orders: Users can read their own orders, create new orders; admins can manage
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }
  }
}
